# ---------------------------------------------------------------------------
# PeerConnect — environment variables
# Copy this file to .env at the repo root (used by docker-compose and prisma)
# and to apps/api/.env and apps/web/.env.local as noted below.
# ---------------------------------------------------------------------------

# ===== Shared / Database ===================================================
# Used by prisma (packages/database) and apps/api
DATABASE_URL="postgresql://peerconnect:peerconnect@localhost:5432/peerconnect?schema=public"

# ===== apps/api ==============================================================
NODE_ENV=development
PORT=4000

# Public URL of this API (used to build the Google OAuth redirect URI)
API_URL="http://localhost:4000"

# Public URL of the web app (used for CORS + post-OAuth redirects)
WEB_URL="http://localhost:3000"

# Comma-separated list of additional allowed CORS origins (optional)
CORS_EXTRA_ORIGINS=""

# Secrets used to sign JWTs. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET="replace-with-a-long-random-value"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-value"

# Token lifetimes
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS="30"

# Cookie domain. Leave empty for localhost. In production, set to your
# apex domain (e.g. ".yourapp.com") so the API subdomain can set cookies
# readable across your frontend subdomain, OR leave unset and rely on
# SameSite=None + Secure for fully cross-site deployments (e.g. Vercel + Render).
COOKIE_DOMAIN=""

# Google OAuth (optional — email/password auth works without these)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:4000/api/auth/google/callback"

# ===== apps/web ==============================================================
# Only NEXT_PUBLIC_* variables are exposed to the browser. Never put secrets here.
NEXT_PUBLIC_API_URL="http://localhost:4000"
